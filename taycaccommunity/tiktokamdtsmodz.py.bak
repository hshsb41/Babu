    def get_history(self, uid):
        uid = Encrypt(uid).hex()
        length = len(uid)
        match length:
            case 8:
                cc = "080112080A04{}1005".format(uid)
            case 10:
                cc = "080112090A05{}1005".format(uid)
            case _:
                return None
        packet = AES_CBC128(bytes.fromhex(cc), self.key, self.iv).hex()
        return bytes.fromhex("0f0100000010" + packet)